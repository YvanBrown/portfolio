---
import type { Project } from "../data/site";
import Icon from "./Icon.astro";
const { project: p, featured = false, delay = 0, pos = "20% 0%" } = Astro.props as { project: Project; featured?: boolean; delay?: number; pos?: string };
const [gx, gy] = pos.split(" ");
---
<article class={`card reveal flex flex-col ${featured ? "md:col-span-3 md:grid md:grid-cols-[1.25fr_1fr]" : ""}`} style={`--d:${delay}ms`}>
  {p.image?.kind === "phone" ? (
    <div class="cover cover-phone" style={`--gx:${gx};--gy:${gy}`}>
      <img src={p.image.src} alt={p.image.alt} width={p.image.w} height={p.image.h} loading="lazy" decoding="async" />
    </div>
  ) : p.image ? (
    <img src={p.image.src} alt={p.image.alt} width={p.image.w} height={p.image.h} loading="lazy" decoding="async" class="block w-full border-b border-line object-cover object-left-top md:h-full md:border-b-0 md:border-r" />
  ) : (
    <div class="cover" style={`--gx:${gx};--gy:${gy}`} role="img" aria-label={`Visuel du projet ${p.title} (capture à fournir)`}>
      <span class="cover-icon"><Icon name={p.icon} /></span>
      <span class="absolute bottom-3 left-4 font-mono text-[0.7rem] text-muted">[Capture à fournir]</span>
    </div>
  )}
  <div class={`flex flex-1 flex-col p-6 ${featured ? "md:p-9" : ""}`}>
    <div>
      {p.client && <p class="font-mono text-xs uppercase tracking-widest text-accent">{p.client}</p>}
      <h3 class={`mt-1 font-display font-semibold ${featured ? "text-2xl sm:text-3xl" : "text-xl"}`}>{p.title}</h3>
      <p class="mt-1 text-sm text-muted">Rôle : {p.role}</p>
      <p class="mt-4 leading-relaxed">{p.summary}</p>
      <ul class="mt-4 flex flex-wrap gap-2" aria-label="Technologies">
        {p.tech.map((t) => <li class="chip">{t}</li>)}
      </ul>
    </div>
    <div class="mt-auto flex flex-col gap-4 pt-6 text-sm">
      {p.links && (
        <ul class="flex flex-wrap gap-2" aria-label="Liens du produit">
          {p.links.map((l) => (
            <li>
              {l.href ? (
                <a href={l.href} target="_blank" rel="noopener noreferrer" class="btn btn-ghost !px-3.5 !py-2 !text-[0.85rem]"><Icon name={l.icon} /> {l.label}</a>
              ) : (
                <span class="btn btn-ghost !px-3.5 !py-2 !text-[0.85rem] cursor-not-allowed opacity-70" title="Lien à venir"><Icon name={l.icon} /> {l.label} <span class="font-mono text-xs text-muted">[URL]</span></span>
              )}
            </li>
          ))}
        </ul>
      )}
      <p class="max-w-md text-muted"><span class="font-mono text-xs uppercase tracking-widest text-accent">Résultat</span><br />{p.result}</p>
      {p.link && (
        <a href={p.link} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 font-medium text-accent hover:text-accent-hover">
          Voir le projet <Icon name="arrow" />
        </a>
      )}
    </div>
  </div>
</article>
