---
import { site, nav } from "../data/site";
import Icon from "./Icon.astro";
---
<a href="#contenu" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[70] focus:rounded-lg focus:bg-accent focus:px-4 focus:py-2 focus:text-on-accent">Aller au contenu</a>
<header class="fixed inset-x-0 top-0 z-50 border-b border-line bg-bg/80 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
    <a href="#top" class="font-display text-[0.78rem] font-semibold leading-tight tracking-wide sm:whitespace-nowrap sm:text-sm" aria-label={site.name}><span class="block sm:inline">{site.givenNames}</span> <span class="block sm:inline">{site.familyName}</span></a>

    <nav class="hidden md:block" aria-label="Navigation principale">
      <ul class="flex items-center gap-7 whitespace-nowrap text-sm text-muted">
        {nav.map((l) => <li><a href={l.href} class="transition-colors hover:text-accent">{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="flex items-center gap-3">
    <button type="button" class="theme-toggle" data-theme-toggle aria-label="Passer en mode clair">
      <span class="icon-moon"><Icon name="moon" /></span><span class="icon-sun"><Icon name="sun" /></span>
    </button>

    <details id="menu-toggle" class="relative md:hidden">
      <summary class="btn btn-ghost cursor-pointer list-none px-4 py-2 text-sm">Menu</summary>
      <ul id="menu" class="absolute right-0 top-12 w-52 rounded-2xl border border-line bg-bg-raised p-2 shadow-xl">
        {nav.map((l) => <li><a href={l.href} class="block rounded-lg px-3 py-2.5 text-sm text-text hover:bg-card hover:text-accent">{l.label}</a></li>)}
      </ul>
    </details>
    </div>
  </div>
</header>
